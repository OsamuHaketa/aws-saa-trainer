# ローカルでは何も設定しなくても動く（local.db を使い、ログインせずに local-owner として学習できる）。
# Google ログインを試すときは、.env.local にコピーして値を入れる。

# DB。未設定なら file:local.db。Turso なら libsql://<db>-<org>.turso.io
DATABASE_URL=
# Turso のトークン（ローカルの DB では不要）
DATABASE_AUTH_TOKEN=

# セッションの署名鍵。openssl rand -base64 32 で作る（環境ごとに別の値）
BETTER_AUTH_SECRET=
# アプリの URL（ローカルは http://localhost:3000）
BETTER_AUTH_URL=

# Google OAuth クライアント。設定すると、ローカルでも Google ログインが必要になる
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ログインを許可するメールアドレス / ドメイン（カンマ区切り）
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
